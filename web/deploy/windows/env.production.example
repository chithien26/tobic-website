# Copy to web\.env.production.local on the server. Used both when building and when running.

# API on Render
API_URL=https://tobic-api.onrender.com
NEXT_PUBLIC_API_URL=https://tobic-api.onrender.com

# Same value as Web__RevalidateSecret on Render
REVALIDATE_SECRET=

# Public address of this website
SITE_URL=https://tobic.com.vn

# Local port IIS forwards to
PORT=3000
