# URL the Next.js server uses to reach the API (internal network in Docker).
API_URL=http://localhost:5080
# URL browsers use to reach the API (media files, admin requests).
NEXT_PUBLIC_API_URL=http://localhost:5080
# Must match Web:RevalidateSecret in the API.
REVALIDATE_SECRET=dev-revalidate-secret
# Public site URL for sitemap, canonical and Open Graph links.
SITE_URL=http://localhost:3000
