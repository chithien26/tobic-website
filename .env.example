# Copy to .env before `docker compose --profile app up -d --build`.

# Database password (Postgres runs inside compose).
POSTGRES_PASSWORD=change-me

# JWT signing key for admin logins, at least 32 random characters.
# PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_KEY=

# Shared secret the API uses to tell the website to refresh after edits.
REVALIDATE_SECRET=

# First admin account, created only when the database has no users.
ADMIN_EMAIL=admin@tobic.com.vn
ADMIN_PASSWORD=

# Public URLs as seen by visitors' browsers.
PUBLIC_SITE_URL=https://tobic.com.vn
PUBLIC_API_URL=https://api.tobic.com.vn
